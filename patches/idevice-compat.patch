+#[cfg(feature = "rsd")]
+impl UniversalHidServiceClient<Box<dyn ReadWrite>> {
+    /// Connect to a compatible Universal HID service whose RSD and feature
+    /// identifiers differ from the current default.
+    pub async fn connect_rsd_named(
+        provider: &mut impl crate::provider::RsdProvider,
+        handshake: &mut crate::rsd::RsdHandshake,
+        service_name: &str,
+        feature_identifier: &str,
+    ) -> Result<Self, IdeviceError> {
+        let service = handshake
+            .services
+            .get(service_name)
+            .ok_or(IdeviceError::ServiceNotFound)?;
+        let stream = provider.connect_to_service_port(service.port).await?;
+        let mut inner = RemoteXpcClient::new(stream).await?;
+        inner.do_handshake().await?;
+        Ok(Self {
+            inner,
+            feature_identifier: Cow::Owned(feature_identifier.to_string()),
+        })
     }
 }
 
